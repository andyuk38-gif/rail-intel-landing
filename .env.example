# Cloudflare Turnstile — contact form human verification
# Create keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Use the same Turnstile widget for railintel.co.uk and localhost if testing locally.
TURNSTILE_SITE_KEY=

# Set the matching secret in Rail-Vault CMS .env as TURNSTILE_SECRET_KEY, then rebuild pages:
# TURNSTILE_SITE_KEY=your_site_key node scripts/build-pages.mjs
